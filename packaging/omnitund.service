[Unit]
Description=Omnitun VPN daemon (Fortinet SSL VPN, IPsec, OpenVPN, L2TP, WireGuard)
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/sbin/omnitund
# A shutdown request exits cleanly so that the new binary starts.
Restart=always
# Time to close the tunnels before SIGKILL (omnitund gives up after 15 s).
TimeoutStopSec=30
# Root is only needed for tun, routes and resolved, and to start the engines
# under their own account (setuid, setgid, kill); keep the rest locked down.
# The engines inherit all of this. CHOWN and FOWNER: the control and prompt
# sockets are given to their users, then their mode is set.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=omnitund
ReadWritePaths=/run
NoNewPrivileges=yes
LimitCORE=0
# Unix sockets (control, prompts, D-Bus), netlink (ip), and the engines'
# connections.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
