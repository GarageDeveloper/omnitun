{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnitun",
  "version": "0.4.5",
  "identifier": "com.root42.omnitun",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Omnitun",
        "width": 440,
        "height": 600,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
